# Shared credentials and application settings. Copy this file to `.env`.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash-0731

# Internal RAG feature
EMBEDDING_BACKEND=openrouter
EMBEDDING_MODEL=baai/bge-m3
RERANKER_BACKEND=openrouter
RERANKER_MODEL=cohere/rerank-v3.5
CHROMA_PATH=data/rag/vector_store/chroma
LLAMA_PARSE_ENABLED=true
LLAMA_CLOUD_API_KEY=

# Question Bank feature
QUESTION_COUNT_DIFFICULTY_1=5
QUESTION_COUNT_DIFFICULTY_2=5
QUESTION_COUNT_DIFFICULTY_3=5
QUESTION_COUNT_DIFFICULTY_4=5
QUESTION_COUNT_DIFFICULTY_5=5
