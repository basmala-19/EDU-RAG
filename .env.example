APP_ENV=local
LOG_LEVEL=INFO
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
VECTOR_STORE=chroma
CHROMA_PATH=data/vector_store/chroma
# Chroma product telemetry is disabled by default for local deployments.
CHROMA_ANONYMIZED_TELEMETRY=false
TOP_K=5
CANDIDATE_MULTIPLIER=4
PARENT_CHUNK_SIZE=1600
CHILD_CHUNK_SIZE=650
CHILD_CHUNK_OVERLAP=80
CHILD_CHUNK_MIN_SIZE=220
HEADING_MAX_LENGTH=180
MAX_CONTEXT_CHARS=6000
MAX_HISTORY_CHARS=3500
MAX_SESSION_TURNS=6
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=10000
SESSION_SWEEP_INTERVAL_SECONDS=300
QUESTION_INDEX_ENABLED=true
MAX_QUESTIONS_PER_CHUNK=4
GENERATION_BACKEND=groq
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Alternative: set GENERATION_BACKEND=ollama and fill these in instead of Groq.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set this after: ollama pull <model>
OLLAMA_MODEL=
OLLAMA_TIMEOUT=90
ALLOW_EXTRACTIVE_FALLBACK=true
LLAMA_CLOUD_API_KEY=
LLAMA_PARSE_ENABLED=true
# Optional: route LlamaParse's page reconstruction through Gemini instead of its default
# vendor model. Leave both empty to keep using LlamaParse's default.
LLAMA_PARSE_VENDOR_MODEL=
GEMINI_API_KEY=

EMBEDDING_ALLOW_HASH_FALLBACK=false
